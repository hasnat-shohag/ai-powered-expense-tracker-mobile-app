{
  "name": "@expense/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "apk:dev": "npx --yes eas-cli build --profile development --platform android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"no lint\" && exit 0",
    "build": "echo \"EAS build in Phase 13\" && exit 0",
    "eas:login": "npx --yes eas-cli login",
    "apk:preview": "npx --yes eas-cli build --profile preview --platform android",
    "apk:production": "npx --yes eas-cli build --profile production --platform android"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expense/shared": "workspace:*",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/roboto": "^0.4.3",
    "expo": "~52.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.4",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-network": "~7.0.5",
    "expo-secure-store": "~14.0.1",
    "expo-speech-recognition": "^1.1.0",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
