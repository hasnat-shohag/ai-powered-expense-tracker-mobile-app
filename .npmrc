# Flat node_modules for the EAS build. EAS's build image runs pnpm 9, which reads
# the linker from this file's `node-linker` key (the `nodeLinker` key in
# pnpm-workspace.yaml is only honored by pnpm 10+, which is what runs locally).
# Expo's Metro config resolves expo-asset / @babel/runtime / drizzle-orm from the
# project root, and pnpm's default isolated layout does not expose them there, so
# the bundle step fails with "The required package `expo-asset` cannot be found".
# Keep this in sync with pnpm-workspace.yaml's nodeLinker: hoisted.
node-linker=hoisted
