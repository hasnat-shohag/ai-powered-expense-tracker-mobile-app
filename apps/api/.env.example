# Neon Postgres (pooled connection string)
DATABASE_URL=

# LLM — OpenAI-compatible, multimodal
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Clerk — per-user auth. Secret key is required; JWT key enables networkless
# verification (paste the PEM public key from the Clerk dashboard).
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Comma-separated Clerk user ids allowed to use the API (empty = any signed-in
# user). ADMIN ids may change subscription plans (empty = nobody).
ALLOWED_CLERK_USER_IDS=
ADMIN_CLERK_USER_IDS=

# Legacy shared secret — no longer honored by auth. Optional, kept for a future
# admin/cron hook.
API_BEARER_TOKEN=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
