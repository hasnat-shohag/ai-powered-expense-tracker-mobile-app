# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
# Exception: @expense/shared ships its compiled output. It is loaded at runtime by
# the Node backend on Vercel and bundled by Metro for the EAS build; both build from
# committed git state, so this dist must be tracked. Rebuild + recommit when src changes.
!packages/shared/dist/
.turbo/
.vercel/
*.tsbuildinfo

# Expo
.expo/
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/*
!.vscode/extensions.json

# Drizzle
apps/api/drizzle/
!apps/api/drizzle/meta

# Impeccable local server state (pid/port/log for the decision page)
.impeccable/questions/
.vercel
.env*
